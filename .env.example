# ===== Telegram =====
# Токен от @BotFather
BOT_TOKEN=

# ===== Локальная LLM (OpenAI-совместимый API) =====
# LM Studio (по умолчанию): сервер на вкладке Developer, обычно порт 1234
LLM_BASE_URL=http://localhost:1234/v1
# llama.cpp на другом компьютере будет так:
# LLM_BASE_URL=http://192.168.1.10:8080/v1

# Имя модели (точно как в /v1/models). Пусто = взять первую загруженную в сервере
LLM_MODEL=

# Ключ API. LM Studio и llama.cpp принимают любое непустое значение
LLM_API_KEY=lm-studio

# Таймаут ответа модели, сек (тяжёлым моделям нужно время)
LLM_TIMEOUT=120

# Максимум токенов в ответе (короче = быстрее и по делу)
LLM_MAX_TOKENS=1200

# Сколько последних реплик истории держать на пользователя
HISTORY_LIMIT=16

# Файл SQLite с историей диалогов (переживает перезапуск бота)
HISTORY_DB=history.db
